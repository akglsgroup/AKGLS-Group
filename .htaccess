# ----------------------------------------------------------------------
# AKGLS Group | Project Root Generic Apache Rewrite (.htaccess)
# ----------------------------------------------------------------------
# If you are hosting the static files or running behind an Apache server
# on Hostinger, this rule delegates all client-side virtual routes to
# the entry point (index.html) so they do not return a 404 on refresh.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # Canonical 301 Redirect: Force HTTPS & Force WWW (akglsgroup.com -> www.akglsgroup.com)
  # ----------------------------------------------------------------------
  # Redirect non-www to www (e.g. akglsgroup.com/healthcare-marketing-services -> https://www.akglsgroup.com/healthcare-marketing-services)
  RewriteCond %{HTTP_HOST} ^akglsgroup\.com$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^akgls\.com$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.akgls\.com$ [NC]
  RewriteRule ^(.*)$ https://www.akglsgroup.com/$1 [R=301,L]

  # Redirect plain HTTP to HTTPS for www.akglsgroup.com
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} ^www\.akglsgroup\.com$ [NC]
  RewriteRule ^(.*)$ https://www.akglsgroup.com/$1 [R=301,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
