# ----------------------------------------------------------------------
# AKGLS Group | Client-side Routing & 404 Fallback Config for Apache
# ----------------------------------------------------------------------
# This file handles URL rewrites. On page refresh, Apache tries to find
# physical files or directories (e.g., /dental-clinic-marketing).
# This rule rewrites those virtual paths to index.html so React Router
# can handle the rendering correctly.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # Canonical 301 Redirect: Force HTTPS & Force WWW (akglsgroup.com -> www.akglsgroup.com)
  # ----------------------------------------------------------------------
  # Redirect non-www to www (e.g. akglsgroup.com/healthcare-marketing-services -> https://www.akglsgroup.com/healthcare-marketing-services)
  RewriteCond %{HTTP_HOST} ^akglsgroup\.com$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^akgls\.com$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.akgls\.com$ [NC]
  RewriteRule ^(.*)$ https://www.akglsgroup.com/$1 [R=301,L]

  # Redirect plain HTTP to HTTPS for www.akglsgroup.com
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} ^www\.akglsgroup\.com$ [NC]
  RewriteRule ^(.*)$ https://www.akglsgroup.com/$1 [R=301,L]

  RewriteRule ^index\.html$ - [L]

  # Dedicated Crawler-Friendly Pre-rendered Pages (Explicit overrides)
  RewriteRule ^geo-services/?$ geo-services.html [L]
  RewriteRule ^hire-ai-seo-expert/?$ hire-ai-seo-expert.html [L]
  RewriteRule ^aeo-services/?$ aeo-services.html [L]
  RewriteRule ^seo-services/?$ seo-services.html [L]

  # Automatically serve any pre-rendered .html file if it exists for the requested path
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+)/?$ $1.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
